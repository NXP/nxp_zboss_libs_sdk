             pMsg->msgData.getReq.PibAttributeValue = phy_get_rsp.PibAttributeValue;
+            wcs_trace_rpmsg_phy(false, pMsg->msgType, pMsg, phyInstance, ret);
         }
     } while(0);
 
@@ -376,6 +385,7 @@ phyStatus_t MAC_PD_SapHandler(macToPdDataMessage_t *pMsg, instanceId_t phyInstan
 
     if (!phy_intf_init_done)
     {
+        wcs_trace_rpmsg_phy(true, pMsg->msgType, (macToPlmeMessage_t *)pMsg, phyInstance, gPhyInvalidParameter_c);
         return gPhyInvalidParameter_c;
     }
 
@@ -398,9 +408,11 @@ phyStatus_t MAC_PD_SapHandler(macToPdDataMessage_t *pMsg, instanceId_t phyInstan
 
         if (HAL_RpmsgSend((hal_rpmsg_handle_t)phyRpmsgHandle, (uint8_t *)pMsg, len) != kStatus_HAL_RpmsgSuccess)
         {
+             wcs_trace_rpmsg_phy(true, pMsg->msgType, (macToPlmeMessage_t *)pMsg, phyInstance, gPhyBusy_c);
