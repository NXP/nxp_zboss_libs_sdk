 uint16_t mlmeGetSizeOfPIB(pibId_t pib);
 
+void wcs_trace_rpmsg_mac(bool tx, macMessageId_t msgType, void *pMsg, instanceId_t macInstanceId, resultType_t ret);
+
 static void mac_msg_free(nwkMessage_t *msg)
 {
     if ((msg->msgType == gMlmeScanCnf_c) && (msg->msgData.scanCnf.scanType == gScanModeED_c))
@@ -96,6 +98,7 @@ static void mac_intf_cb_task_func()
         {
             msg_free = TRUE;
 
+            wcs_trace_rpmsg_mac(false, msg->msgType, msg, msg->mac_id, gSuccess_c);
             switch (msg->msgType)
             {
                 case gMcpsDataInd_c:
@@ -350,6 +353,7 @@ resultType_t NWK_MLME_SapHandler(mlmeMessage_t* req, nwkMessage_t *cnf, instance
 
     if (!mac_intf_init_done)
     {
+        wcs_trace_rpmsg_mac(true, req->msgType, req, macInstanceId, gInvalidParameter_c);
         return gInvalidParameter_c;
     }
 
@@ -395,17 +399,32 @@ resultType_t NWK_MLME_SapHandler(mlmeMessage_t* req, nwkMessage_t *cnf, instance
 
         if (HAL_RpmsgSend((hal_rpmsg_handle_t)mac_rpmsg_handle, msg, len) != kStatus_HAL_RpmsgSuccess)
         {
+            wcs_trace_rpmsg_mac(true, req->msgType, req, macInstanceId, gInvalidParameter_c);
             ret = gInvalidParameter_c;
             break;
         }
+        wcs_trace_rpmsg_mac(true, req->msgType, req, macInstanceId, ret);
 
         if (req->msgType == gMlmeGetReq_c)
         {
             wait_response();
             wait_mac_rsp = FALSE;
 
+            cnf->msgData.getCnf.pibAttribute = req->msgData.getReq.pibAttribute;
             cnf->msgData.getCnf.pibAttributeLength = mac_get_pib_rsp.pibAttributeLength;
             cnf->msgData.getCnf.pibAttributeValue = mac_get_pib_rsp.pibAttributeValue;
+            wcs_trace_rpmsg_mac(false, req->msgType, cnf, macInstanceId, ret);
+        }
+        if (req->msgType == gMlmeStartReq_c)
+        {
+            uint8_t      msgType   = cnf->msgType;
+            resultType_t msgStatus = cnf->msgData.startCnf.status;
+
+            cnf->msgType                 = gMlmeStartCnf_c;
+            cnf->msgData.startCnf.status = ret;
+            wcs_trace_rpmsg_mac(false, req->msgType, req, macInstanceId, ret);
+            cnf->msgType                 = msgType;
+            cnf->msgData.startCnf.status = msgStatus;
         }
     } while (0);
 
@@ -432,6 +451,7 @@ resultType_t NWK_MCPS_SapHandler(nwkToMcpsMessage_t* pMsg, instanceId_t macInsta
 
     if (!mac_intf_init_done)
     {
+        wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, gInvalidParameter_c);
         return gInvalidParameter_c;
     }
 
@@ -454,9 +474,11 @@ resultType_t NWK_MCPS_SapHandler(nwkToMcpsMessage_t* pMsg, instanceId_t macInsta
 
         if (HAL_RpmsgSend((hal_rpmsg_handle_t)mac_rpmsg_handle, (uint8_t *)pMsg, len) != kStatus_HAL_RpmsgSuccess)
         {
+            wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, gInvalidParameter_c);
             ret = gInvalidParameter_c;
             break;
         }
+        wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, ret);
     } while (0);
 
     PLATFORM_RemoteActiveRel();
@@ -570,6 +592,7 @@ resultType_t MAC_Proxy_PLME_SapHandler(macToPlmeMessage_t * pMsg, instanceId_t m
 
     if (!mac_intf_init_done)
     {
+        wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, gInvalidParameter_c);
         return gInvalidParameter_c;
     }
 
@@ -595,16 +618,20 @@ resultType_t MAC_Proxy_PLME_SapHandler(macToPlmeMessage_t * pMsg, instanceId_t m
 
         if (HAL_RpmsgSend((hal_rpmsg_handle_t)mac_rpmsg_handle, (uint8_t *)pMsg, sizeof(macToPlmeMessage_t)) != kStatus_HAL_RpmsgSuccess)
         {
+            wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, gInvalidParameter_c);
             ret = gInvalidParameter_c;
             break;
         }
+        wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, ret);
 
         if (pMsg->msgType == gPlmeGetReq_c)
         {
             wait_response();
             wait_proxy_rsp = FALSE;
 
+            pMsg->msgData.getReq.PibAttribute = phy_get_rsp.PibAttribute;
             pMsg->msgData.getReq.PibAttributeValue = phy_get_rsp.PibAttributeValue;
+            wcs_trace_rpmsg_mac(false, pMsg->msgType, pMsg, macInstanceId, ret);
         }
     } while (0);
 
@@ -622,6 +649,7 @@ resultType_t MAC_Plat_Cmd(macPlatMessage_t *pMsg, instanceId_t macInstanceId)
 
     if (!mac_intf_init_done)
     {
+        wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, gInvalidParameter_c);
         return gInvalidParameter_c;
     }
 
@@ -647,9 +675,11 @@ resultType_t MAC_Plat_Cmd(macPlatMessage_t *pMsg, instanceId_t macInstanceId)
 
         if (HAL_RpmsgSend((hal_rpmsg_handle_t)mac_rpmsg_handle, (uint8_t *)pMsg, sizeof(macPlatMessage_t) + pMsg->data_len) != kStatus_HAL_RpmsgSuccess)
         {
+            wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, gInvalidParameter_c);
             ret = gInvalidParameter_c;
             break;
         }
+        wcs_trace_rpmsg_mac(true, pMsg->msgType, pMsg, macInstanceId, ret);
 
         if (pMsg->is_get)
         {
@@ -666,6 +696,7 @@ resultType_t MAC_Plat_Cmd(macPlatMessage_t *pMsg, instanceId_t macInstanceId)
                 memcpy((uint8_t *)pMsg + sizeof(macPlatMessage_t), (uint8_t *)plat_get_rsp + sizeof(macPlatMessage_t), pMsg->data_len);
 
                 MSG_Free(plat_get_rsp);
+                wcs_trace_rpmsg_mac(false, pMsg->msgType, pMsg, macInstanceId, ret);
             }
         }
     } while (0);
