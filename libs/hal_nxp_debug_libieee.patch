                 if (phyLocal[msg->ctx_id].ext_cmd_handler)
                 {
                     ext_phy_cmd_t *m = (ext_phy_cmd_t *)msg;
@@ -131,6 +135,7 @@ static void phy_intf_cb_task_func()
             }
             else
             {
+                wcs_trace_rpmsg_phy(false, msg->msgType, (macToPlmeMessage_t *)msg, msg->ctx_id, gPhySuccess_c);
