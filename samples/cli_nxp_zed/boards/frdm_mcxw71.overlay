/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};
};

/* Delete all existing partitions */
/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;
/delete-node/ &hw_params_partition;

/* Redefine internal flash partitions */
&flash {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
		label = "mcuboot";
		reg = <0x0 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
		label = "image-0";
		reg = <0x10000 DT_SIZE_K(424)>;
		};

		slot1_partition: partition@7a000 {
		label = "image-1";
		reg = <0x7a000 DT_SIZE_K(424)>;
		};

		storage_partition: partition@e4000 {
		label = "storage";
		reg = <0xe4000 DT_SIZE_K(72)>;
		};

		zb_nvram: partition@f6000 {
		label = "zb-nvram";
		reg = <0xf6000 DT_SIZE_K(32)>;
		};

		hw_params_partition: partition@fe000 {
		label = "hw-parameters";
		reg = <0xfe000 DT_SIZE_K(8)>;
		};
	};
};
