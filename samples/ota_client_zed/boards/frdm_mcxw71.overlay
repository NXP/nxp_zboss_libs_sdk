/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};
};

/* Delete all existing partitions */
/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

/* Redefine internal flash partitions */
&flash {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x0 DT_SIZE_K(912)>;
		};

		storage_partition: partition@e4000 {
			label = "storage";
			reg = <0xe4000 DT_SIZE_K(80)>;
		};

		zb_nvram: partition@f8000 {
			label = "zb-nvram";
			reg = <0xf8000 DT_SIZE_K(32)>;
		};
	};
};

&mx25r6435fm2il0 {
	status = "okay";
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot1_partition: partition@0 {
			label = "image-1";
			reg = <0x0 DT_SIZE_M(1)>;
		};
	};
};

&ieee802154_eui64_ifr0 {
	status = "okay";
};

&zb_settings_ifr0 {
	status = "okay";
};

&zb_secured_ifr0 {
	status = "okay";
};
