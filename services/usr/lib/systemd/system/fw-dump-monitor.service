[Unit]
Description=NXP Firmware Dump Monitor
Documentation=NXP firmware dump monitoring service
After=bluetooth.service sysinit.target
Wants=bluetooth.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/local
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
ExecStart=/usr/sbin/fw-dump-monitor.sh --dir /var/log/fw_dumps --verbose start
ExecStop=/usr/sbin/fw-dump-monitor.sh stop
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fw-dump-monitor

# Ensure access to system resources
NoNewPrivileges=false
PrivateDevices=false
ProtectSystem=false
ProtectHome=false
ProtectKernelLogs=false

[Install]
WantedBy=multi-user.target
