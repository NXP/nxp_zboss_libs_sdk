[Unit]
Description=ZBOSS Application
Requires=zb_mux.service
After=zb_mux.service
StartLimitIntervalSec=500
# Try 5 attempts, if it still fails, systemd will stop trying to start the service
StartLimitBurst=5

[Service]
EnvironmentFile=/etc/default/zb_app.env
WorkingDirectory=/var/local/zboss
ExecStart=/usr/sbin/zb_app.sh
Restart=on-failure
RestartSec=1
#Don"t restart on kill -9:
#RestartPreventExitStatus=SIGKILL

[Install]
WantedBy=multi-user.target
Alias=zb_app.service
