[Unit]
Description=ZBOSS Muxer
ConditionPathExists=/usr/sbin/zb_mux
#requires to comment /etc/modprobe.d/blacklist.conf:blacklist btnxpuart
Before=zb_app.service otbr-agent.service
After=zb_config.service
Requires=zb_config.service

[Service]
EnvironmentFile=/etc/default/zb_mux.env
WorkingDirectory=/var/local/zboss
ExecStart=/usr/sbin/zb_mux.sh
Restart=on-failure
RestartSec=1
#Don"t restart on kill -9:
#RestartPreventExitStatus=SIGKILL

[Install]
WantedBy=multi-user.target
Alias=zb_mux.service
